{
  "name": "@wano/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RecIO Rewards REST API (Express 5 + node:sqlite)",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "seed": "node src/seed/seed.ts",
    "test": "node scripts/run-tests.mjs",
    "dev:watch": "node --watch src/index.ts",
    "test:node": "node --test --test-concurrency=1 tests/",
    "seed:prod": "node dist/seed/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.2",
    "stripe": "^23.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3"
  }
}
