# ---------------------------------------------------------------------------
# RecIO Rewards API — environment template
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_VERSION=1.0.0

# SQLite file, resolved relative to apps/api. On a persistent volume use an
# absolute path, e.g. DB_PATH=/app/data/recio.db.
DB_PATH=data/recio.db

# --- Auth -------------------------------------------------------------------
# 32+ random bytes in production. The API refuses to boot in production with
# the development default.
JWT_SECRET=dev-only-change-me-please-use-32-random-bytes
JWT_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_DAYS=60

# AUTH_DEV_MODE=true returns `devCode` from /auth/request-otp and accepts the
# fixed code 123456. Set to false to generate random 6-digit codes (an SMS
# gateway integration point is logged in src/services/auth.ts).
AUTH_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Demo / seeded data -----------------------------------------------------
# DEMO_MODE enables POST /sessions/:id/simulate-deposit and mock payments.
DEMO_MODE=true
# Auto-seed an empty database on boot (demo convenience). Disable in prod.
AUTO_SEED=true

# --- Stripe (test mode) -----------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to use the built-in "mock" provider.
STRIPE_SECRET_KEY=
# From `stripe listen` or the Dashboard webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl

# --- PIX payouts ------------------------------------------------------------
# `mock` (default in development/test) or `asaas`. Production must select a
# provider explicitly: a missing/invalid value or missing Asaas credentials
# makes POST /payouts fail with 503 instead of silently faking a transfer.
PIX_PROVIDER=mock

# Fee charged to the user per payout, in cents (default R$ 1.50). The provider
# receives amountCents - feeCents; the ledger records the full user debit.
PIX_PAYOUT_FEE_CENTS=150

# Minimum payout and daily cap, in cents (R$ 20.00 and R$ 500.00).
PIX_MIN_CENTS=2000
PIX_DAILY_CAP_CENTS=50000

# Asaas API v3 (sandbox default). Leave ASAAS_API_KEY empty to fall back to
# mock outside production.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api
# Shared token configured in the Asaas webhook; must match the incoming
# `asaas-access-token` header.
ASAAS_WEBHOOK_TOKEN=

# --- HTTP -------------------------------------------------------------------
# Extra allowed CORS origins (comma separated). Dev reflects any origin;
# production always allows the Expo dev origins plus this list.
CORS_ORIGINS=
SUPPORT_EMAIL=ajuda@recio.com.br
PUBLIC_WEB_URL=https://recio.app
APP_SCHEME=recio

LOG_LEVEL=debug
LOG_JSON=false
TRUST_PROXY=false
# Disable rate limiting only for local load tests.
RATE_LIMIT_DISABLED=false
